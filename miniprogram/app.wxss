@import "./assets/fonts/snowlit-sans.wxss";

page {
  min-height: 100%;
  background: #f7f7f7;
  color: #111111;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 96rpx 48rpx 132rpx;
  background: #f7f7f7;
}

.snowlit-tab-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 153rpx 44rpx 162rpx;
  overflow-x: hidden;
  color: #050505;
  background: #fbfbfb;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.snowlit-page-heading {
  color: #050505;
}

.snowlit-page-brand {
  color: #050505;
  font-size: 21rpx;
  font-weight: 400;
  letter-spacing: 16rpx;
  line-height: 26rpx;
}

.snowlit-page-title {
  margin-top: 31rpx;
  color: #050505;
  font-size: 57rpx;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 69rpx;
}

.snowlit-page-subtitle {
  margin-top: 19rpx;
  color: #777777;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 38rpx;
}

.snowlit-subpage-heading {
  color: #050505;
}

.snowlit-subpage-brand {
  color: #050505;
  font-size: 21rpx;
  font-weight: 400;
  letter-spacing: 16rpx;
  line-height: 26rpx;
}

.snowlit-subpage-title {
  margin-top: 31rpx;
  color: #050505;
  font-size: 57rpx;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 69rpx;
}

.snowlit-subpage-subtitle {
  margin-top: 19rpx;
  color: #777777;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 38rpx;
}

.page-eyebrow {
  color: #8a8a8a;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 28rpx;
  color: #111111;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.2;
}

.page-divider {
  width: 100%;
  height: 1rpx;
  margin: 40rpx 0;
  background: #dedede;
}

.page-description {
  color: #6f6f6f;
  font-size: 28rpx;
  line-height: 1.75;
}

.minimal-button {
  min-height: 88rpx;
  padding: 0 36rpx;
  color: #ffffff;
  background: #111111;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
  text-align: center;
}

.minimal-button--ghost {
  color: #111111;
  background: transparent;
  border: 1rpx solid #111111;
}

.minimal-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  color: #111111;
  background: transparent;
  border-bottom: 1rpx solid #d6d6d6;
  font-size: 30rpx;
}

.minimal-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx 0;
  color: #111111;
  background: transparent;
  border-bottom: 1rpx solid #d6d6d6;
  font-size: 30rpx;
  line-height: 1.65;
}

.snowlit-end-tip {
  margin-top: 48rpx;
  color: #9a9a9a;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
}

.snowlit-end-tip--compact {
  margin-top: 32rpx;
}
