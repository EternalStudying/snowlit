@import "./assets/fonts/snowlit-kai.wxss";
@import "./assets/fonts/snowlit-serif.wxss";

/*
 * Snowlit mini program palette: a lit window in the snow.
 *   snow     #f3f6fa  page ground          ink      #1d2433  text, primary buttons
 *   surface  #ffffff  grouped rows, cards  muted    #6b7385  secondary text
 *   line     #dce2ea  hairlines            fill     #ebeff5  pressed / placeholder fills
 *   lamp     #e8a23a  the one accent: "lit" marks only (current tab, wordmark dot, pinned,
 *                     the day count); never body text. lamp-text #a8661a when amber must be read.
 *
 * Type: the system font for everything people read or type. Two bundled subsets add character:
 *   Snowlit Kai (LXGW WenKai)    fixed headings only, via .snowlit-kai; never bound/user text
 *   Snowlit Serif (Source Serif 4) the wordmark, counts and dates, via .snowlit-serif
 * Rebuild both with tools/miniprogram-fonts/build_fonts.py after changing a .snowlit-kai heading.
 */

page {
  min-height: 100%;
  background: #ebeff5;
  color: #1d2433;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 96rpx 48rpx 132rpx;
  background: #ebeff5;
}

.snowlit-tab-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 153rpx 44rpx 162rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
}

.snowlit-page-heading {
  color: #1d2433;
}

.snowlit-page-brand {
  display: flex;
  font-family: "Snowlit Serif", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
  align-items: center;
  color: #1d2433;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 30rpx;
  text-transform: lowercase;
}

.snowlit-page-brand::after {
  content: "";
  width: 10rpx;
  height: 10rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #e8a23a;
  box-shadow: 0 0 12rpx rgba(232, 162, 58, 0.55);
}

.snowlit-page-title {
  margin-top: 26rpx;
  color: #1d2433;
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 72rpx;
}

.snowlit-page-subtitle {
  margin-top: 14rpx;
  color: #6b7385;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 40rpx;
}

.snowlit-subpage-heading {
  color: #1d2433;
}

.snowlit-subpage-brand {
  display: flex;
  font-family: "Snowlit Serif", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
  align-items: center;
  color: #1d2433;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 30rpx;
  text-transform: lowercase;
}

.snowlit-subpage-brand::after {
  content: "";
  width: 10rpx;
  height: 10rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #e8a23a;
  box-shadow: 0 0 12rpx rgba(232, 162, 58, 0.55);
}

.snowlit-subpage-title {
  margin-top: 26rpx;
  color: #1d2433;
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 72rpx;
}

.snowlit-subpage-subtitle {
  margin-top: 14rpx;
  color: #6b7385;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 40rpx;
}

.page-eyebrow {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 28rpx;
  color: #1d2433;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.2;
}

.page-divider {
  width: 100%;
  height: 1rpx;
  margin: 40rpx 0;
  background: #dce2ea;
}

.page-description {
  color: #555e70;
  font-size: 28rpx;
  line-height: 1.75;
}

.minimal-button {
  min-height: 88rpx;
  padding: 0 36rpx;
  color: #ffffff;
  background: #1d2433;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
  text-align: center;
}

.minimal-button--ghost {
  color: #1d2433;
  background: transparent;
  border: 1rpx solid #1d2433;
}

.minimal-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  color: #1d2433;
  background: transparent;
  border-bottom: 1rpx solid #dce2ea;
  font-size: 30rpx;
}

.minimal-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx 0;
  color: #1d2433;
  background: transparent;
  border-bottom: 1rpx solid #dce2ea;
  font-size: 30rpx;
  line-height: 1.65;
}

.snowlit-end-tip {
  margin-top: 48rpx;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
}

.snowlit-end-tip--compact {
  margin-top: 32rpx;
}

/* Headings with fixed text, written in the hand-lettered face. Kai has one weight; never fake bold. */
page .snowlit-kai {
  font-family: "Snowlit Kai", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* Counts and dates: lining, tabular serif figures that line up and read like a dated journal. */
page .snowlit-serif {
  font-family: "Snowlit Serif", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-variant-numeric: lining-nums tabular-nums;
  font-feature-settings: "lnum", "tnum";
}
