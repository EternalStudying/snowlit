.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  color: #555e70;
  font-size: 22rpx;
  line-height: 44rpx;
}

.status-pill--strong {
  border-color: #1d2433;
  color: #1d2433;
}

.status-pill--success {
  border-color: #246b45;
  color: #246b45;
}

.status-pill--danger {
  border-color: #9b1c1c;
  color: #9b1c1c;
}
