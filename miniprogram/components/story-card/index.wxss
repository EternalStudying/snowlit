.story-card {
  padding: 32rpx 0;
  border-top: 1rpx solid #dce2ea;
}

.story-card__meta {
  color: #6b7385;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.story-card__title {
  margin-top: 14rpx;
  color: #1d2433;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.35;
}

.story-card__content {
  margin: 12rpx 0 20rpx;
  color: #555e70;
  font-size: 26rpx;
  line-height: 1.65;
}
