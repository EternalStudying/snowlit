.story-card {
  padding: 32rpx 0;
  border-top: 1rpx solid #dedede;
}

.story-card__meta {
  color: #8a8a8a;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.story-card__title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.35;
}

.story-card__content {
  margin: 12rpx 0 20rpx;
  color: #6f6f6f;
  font-size: 26rpx;
  line-height: 1.65;
}
