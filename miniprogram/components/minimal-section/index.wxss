.minimal-section {
  padding: 44rpx 0;
  border-top: 1rpx solid #dce2ea;
}

.minimal-section__head {
  display: flex;
  gap: 32rpx;
  align-items: flex-start;
}

.minimal-section__label {
  width: 148rpx;
  flex: none;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.minimal-section__content {
  min-width: 0;
  flex: 1;
}

.minimal-section__title {
  color: #1d2433;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.35;
}

.minimal-section__caption {
  margin-top: 8rpx;
  color: #6b7385;
  font-size: 26rpx;
  line-height: 1.55;
}

.minimal-section__body {
  margin-top: 28rpx;
}
