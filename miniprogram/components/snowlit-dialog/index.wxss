.snowlit-dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: rgba(5, 5, 5, 0.26);
  opacity: 0;
  transition: opacity 180ms ease;
}

.snowlit-dialog-mask--visible {
  opacity: 1;
}

.snowlit-dialog-card {
  width: 100%;
  padding: 34rpx 34rpx 28rpx;
  color: #050505;
  background: rgba(251, 251, 251, 0.98);
  border: 1rpx solid rgba(5, 5, 5, 0.12);
  border-radius: 18rpx;
  box-shadow: 0 30rpx 80rpx rgba(5, 5, 5, 0.18);
  transform: translateY(10rpx) scale(0.98);
  transition: transform 180ms ease;
}

.snowlit-dialog-mask--visible .snowlit-dialog-card {
  transform: translateY(0) scale(1);
}

.snowlit-dialog-brand {
  color: #777777;
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 12rpx;
  line-height: 25rpx;
}

.snowlit-dialog-title {
  margin-top: 24rpx;
  color: #050505;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 45rpx;
}

.snowlit-dialog-content {
  margin-top: 17rpx;
  color: #666666;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 42rpx;
  white-space: pre-line;
  word-break: break-word;
}

.snowlit-dialog-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 32rpx;
}

.snowlit-dialog-actions--split {
  justify-content: space-between;
}

.snowlit-dialog-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 60rpx;
}

.snowlit-dialog-button--cancel {
  color: #666666;
  background: transparent;
  border: 1rpx solid #d7d7d7;
}

.snowlit-dialog-button--confirm {
  color: #ffffff;
  background: #050505;
}
