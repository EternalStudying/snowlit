.privacy-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
}

.privacy-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(5, 5, 5, 0.28);
}

.privacy-panel {
  position: absolute;
  right: 42rpx;
  bottom: 76rpx;
  left: 42rpx;
  padding: 38rpx 34rpx 32rpx;
  color: #050505;
  background: #ffffff;
  border: 1rpx solid rgba(5, 5, 5, 0.1);
  border-radius: 18rpx;
  box-shadow: 0 20rpx 54rpx rgba(5, 5, 5, 0.14);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.privacy-message {
  margin-top: 18rpx;
  color: #777777;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.privacy-link {
  display: inline-flex;
  margin-top: 20rpx;
  color: #050505;
  font-size: 25rpx;
  line-height: 36rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.privacy-actions {
  display: flex;
  column-gap: 16rpx;
  margin-top: 34rpx;
}

.privacy-button {
  flex: 1;
  height: 78rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 78rpx;
}

.privacy-button::after {
  border: 0;
}

.privacy-button--ghost {
  color: #555555;
  background: #f4f4f4;
}

.privacy-button--primary {
  color: #ffffff;
  background: #050505;
}
