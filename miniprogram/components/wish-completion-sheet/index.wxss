@import "../snowlit-sheet.wxss";

.completion-panel {
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
}

.completion-copy {
  margin-top: 12rpx;
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.completion-photo-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 330rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border: 1rpx dashed #dce2ea;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
}

.completion-photo {
  width: 100%;
  height: 100%;
}

.completion-photo-remove {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 42rpx;
  height: 42rpx;
  color: #ffffff;
  border-radius: 50%;
  background: rgba(29, 36, 51, 0.68);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 39rpx;
  text-align: center;
}

.completion-photo-icon {
  width: 54rpx;
  height: 54rpx;
}

.completion-photo-text {
  margin-left: 18rpx;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.completion-confirm {
  height: 82rpx;
  margin: 30rpx 0 0;
  padding: 0;
  color: #ffffff;
  background: #1d2433;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 82rpx;
}

.completion-confirm::after {
  border: 0;
}

.completion-confirm--disabled {
  opacity: 0.45;
}
