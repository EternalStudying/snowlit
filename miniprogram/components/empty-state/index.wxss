.empty-state {
  padding: 56rpx 0;
  border-top: 1rpx solid #dce2ea;
  border-bottom: 1rpx solid #dce2ea;
}

.empty-state__title {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 500;
}

.empty-state__description {
  margin-top: 14rpx;
  color: #6b7385;
  font-size: 26rpx;
  line-height: 1.65;
}

.empty-state__action {
  display: inline-block;
  margin-top: 28rpx;
  color: #1d2433;
  font-size: 26rpx;
  line-height: 1;
  text-decoration: underline;
}
