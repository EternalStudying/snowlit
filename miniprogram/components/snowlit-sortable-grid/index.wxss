.sortable-grid {
  display: grid;
  gap: 18rpx;
  overflow: visible;
}
.sortable-item {
  position: relative;
  min-width: 0;
  aspect-ratio: 1 / 1;
  border-radius: 8rpx;
  background: #ebeff5;
  transition: transform 160ms ease;
}
.sortable-image { display: block; width: 100%; height: 100%; border-radius: 8rpx; }
.sortable-badge { position: absolute; top: 8rpx; left: 8rpx; padding: 5rpx 12rpx; color: #fff; background: rgba(29, 36, 51, .75); border-radius: 6rpx; font-size: 20rpx; }
.sortable-message { position: absolute; bottom: 0; right: 0; left: 0; padding: 8rpx 10rpx; color: #fff; background: rgba(29, 36, 51, .58); font-size: 20rpx; text-align: center; border-radius: 0 0 8rpx 8rpx; }
.sortable-progress { position: absolute; bottom: 0; left: 0; height: 5rpx; background: #fff; }
