@import "../snowlit-sheet.wxss";

.snowlit-option-list {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #dedede;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
}

.snowlit-option-row {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #dedede;
}

.snowlit-option-row:last-child {
  border-bottom: 0;
}

.snowlit-option-row--active {
  background: rgba(5, 5, 5, 0.04);
}

.snowlit-option-label {
  flex: 1;
  min-width: 0;
  color: #050505;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.snowlit-option-mark {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #050505;
}
