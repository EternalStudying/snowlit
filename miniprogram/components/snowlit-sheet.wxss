.snowlit-sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9997;
  background: rgba(29, 36, 51, 0.22);
  opacity: 0;
  transition: opacity 220ms ease;
}

.snowlit-sheet-mask--visible {
  opacity: 1;
}

.snowlit-sheet-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 28rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  color: #1d2433;
  background: rgba(243, 246, 250, 0.98);
  border-top: 1rpx solid rgba(29, 36, 51, 0.1);
  border-radius: 26rpx 26rpx 0 0;
  box-shadow: 0 -24rpx 68rpx rgba(29, 36, 51, 0.14);
  transform: translateY(100%);
  transition: transform 260ms ease;
}

.snowlit-sheet-mask--visible .snowlit-sheet-panel {
  transform: translateY(0);
}

.snowlit-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
}

.snowlit-sheet-title {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.snowlit-sheet-cancel,
.snowlit-sheet-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 58rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 58rpx;
}

.snowlit-sheet-cancel {
  color: #6b7385;
}

.snowlit-sheet-confirm {
  color: #ffffff;
  background: #1d2433;
}

.snowlit-sheet-picker {
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
}

.snowlit-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 72rpx;
}
