.diary-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 52rpx 84rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
}

.top-action {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.diary-head {
  padding-top: 183rpx;
  padding-bottom: 34rpx;
}

.detail-state {
  min-height: 520rpx;
  padding-top: 260rpx;
  color: #6b7385;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.diary-mood {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  margin-top: 29rpx;
  padding: 0 22rpx;
  color: #3a4254;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 40rpx;
}

.section-line {
  width: 100%;
  height: 1rpx;
  background: #dce2ea;
}

.content-section {
  padding: 38rpx 0 40rpx;
}

.content-block {
  width: 100%;
}

.content-block--spaced {
  margin-top: 14rpx;
}

.content-block--first,
.content-block--tight {
  margin-top: 0;
}

.content-text {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
  white-space: pre-wrap;
}

.content-heading {
  color: #1d2433;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 46rpx;
}

.content-heading--3,
.content-heading--4,
.content-heading--5,
.content-heading--6 {
  font-size: 31rpx;
  line-height: 44rpx;
}

.content-quote {
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  color: #5f493f;
  border-left: 5rpx solid rgba(196, 125, 103, 0.42);
  background: rgba(255, 236, 205, 0.46);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.content-list {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.content-list-item {
  display: flex;
  align-items: flex-start;
}

.content-list-marker {
  flex: 0 0 48rpx;
  color: #555e70;
  line-height: 44rpx;
}

.content-list-text {
  flex: 1;
  min-width: 0;
  line-height: 44rpx;
  word-break: break-word;
}

.content-code {
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  color: #6f4e3f;
  border: 1rpx solid rgba(174, 124, 86, 0.2);
  border-radius: 8rpx;
  background: rgba(255, 239, 210, 0.72);
  font-family: Consolas, "Courier New", monospace;
  font-size: 25rpx;
  line-height: 38rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.content-hr {
  height: 1rpx;
  border-top: 1rpx dashed rgba(121, 86, 65, 0.28);
}

.content-table {
  overflow: hidden;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
  color: #1d2433;
  font-size: 24rpx;
  line-height: 34rpx;
}

.content-table-row {
  display: flex;
  border-top: 1rpx solid #ebeff5;
}

.content-table-row--header {
  border-top: 0;
  background: rgba(255, 239, 210, 0.62);
  font-weight: 600;
}

.content-table-cell {
  flex: 1;
  min-width: 0;
  padding: 12rpx 14rpx;
  border-left: 1rpx solid #ebeff5;
  word-break: break-word;
}

.content-table-cell:first-child {
  border-left: 0;
}

.content-image-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.content-image {
  display: block;
  width: 50%;
  border-radius: 8rpx;
  background: #ebeff5;
}

.meta-section {
  padding-top: 14rpx;
}

.meta-row {
  display: grid;
  grid-template-columns: 168rpx 1fr;
  align-items: start;
  min-height: 82rpx;
  padding-top: 28rpx;
}

.meta-label {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 34rpx;
}

.meta-value {
  min-width: 0;
  color: #1d2433;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  word-break: break-word;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 20rpx;
  align-items: center;
  margin-top: 46rpx;
  border-top: 1rpx solid #dce2ea;
  border-bottom: 1rpx solid #dce2ea;
}

.detail-action {
  height: 88rpx;
  color: #1d2433;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 88rpx;
  text-align: center;
}

.detail-action--delete {
  color: #a05a5a;
}
