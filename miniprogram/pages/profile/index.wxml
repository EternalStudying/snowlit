<view class="profile-page snowlit-tab-page">
  <view class="profile-message" wx:if="{{loading}}">账号信息加载中...</view>
  <view class="profile-message" wx:elif="{{message}}">{{message}}</view>

  <view class="user-panel" bindtap="handleProfileTap">
    <view class="avatar-placeholder">{{user.initial}}</view>
    <view class="user-main">
      <view class="user-name">{{user.displayName}}</view>
      <view class="user-username">@{{user.username}}</view>

      <view class="user-fields">
        <view class="user-field">
          <view class="field-label">心情</view>
          <view class="field-value">{{user.mood}}</view>
        </view>
        <view class="user-field-divider"></view>
        <view class="user-field">
          <view class="field-label">简介</view>
          <view class="field-value">{{user.bio}}</view>
        </view>
      </view>
    </view>
    <image class="panel-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
  </view>

  <view class="section-line"></view>

  <view class="section-heading snowlit-kai">账号</view>
  <view class="list-card account-card">
    <view
      class="info-row"
      wx:for="{{accountRows}}"
      wx:key="label"
    >
      <image class="row-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="row-label">{{item.label}}</view>
      <view class="row-value">{{item.value}}</view>
    </view>
  </view>

  <view class="notice-head">
    <view class="section-heading notice-label snowlit-kai">公告</view>
    <view class="notice-version">{{notice.version}}</view>
  </view>
  <view class="notice-card" bindtap="handleNoticeTap">
    <view class="notice-title-row">
      <view class="notice-title">{{notice.title}}</view>
      <image class="notice-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
    </view>
    <view class="notice-date">{{notice.publishedAt}}</view>
    <view class="notice-divider"></view>
    <view class="notice-item">· {{notice.item}}</view>
  </view>

  <view class="section-heading actions-heading snowlit-kai">更多</view>
  <view class="list-card action-card">
    <view
      class="info-row action-row"
      wx:for="{{actionRows}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="handleActionTap"
    >
      <image class="row-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="row-label">{{item.label}}</view>
      <image class="action-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="updated-line">更新 {{user.updatedAt}}</view>
  <view class="snowlit-end-tip">没有更多了哦~</view>
</view>

<snowlit-toast id="snowlit-toast" />
<snowlit-dialog id="snowlit-dialog" />
