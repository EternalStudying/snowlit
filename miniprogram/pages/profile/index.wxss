.user-panel {
  position: relative;
  display: grid;
  grid-template-columns: 182rpx minmax(0, 1fr);
  column-gap: 35rpx;
  margin-top: 0;
  align-items: center;
}

.profile-message {
  min-height: 72rpx;
  margin-top: 34rpx;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 72rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 162rpx;
  height: 162rpx;
  color: #3a4254;
  background: #ebeff5;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
}

.user-main {
  min-width: 0;
  padding-right: 44rpx;
}

.user-name {
  color: #1d2433;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 52rpx;
}

.user-username {
  margin-top: 9rpx;
  color: #6b7385;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.user-fields {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  column-gap: 46rpx;
  margin-top: 35rpx;
  align-items: center;
}

.user-field {
  min-width: 0;
}

.field-label {
  color: #6b7385;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 27rpx;
}

.field-value {
  margin-top: 13rpx;
  color: #1d2433;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.user-field-divider {
  width: 1rpx;
  height: 33rpx;
  background: #dce2ea;
}

.panel-chevron {
  position: absolute;
  top: 15rpx;
  right: 7rpx;
  width: 40rpx;
  height: 40rpx;
}

.updated-line {
  margin-top: 48rpx;
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 32rpx;
  text-align: center;
}

.section-line {
  width: 100%;
  height: 1rpx;
  margin-top: 29rpx;
  background: #dce2ea;
}

.section-heading {
  margin-top: 36rpx;
  color: #1d2433;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 31rpx;
}

.list-card,
.notice-card {
  overflow: hidden;
  border: 1rpx solid #dce2ea;
  border-radius: 9rpx;
  background: #f3f6fa;
}

.account-card {
  margin-top: 24rpx;
}

.info-row {
  position: relative;
  display: grid;
  grid-template-columns: 55rpx minmax(0, 1fr) auto;
  column-gap: 28rpx;
  align-items: center;
  min-height: 76rpx;
  padding: 0 28rpx;
}

.info-row + .info-row::before {
  position: absolute;
  top: 0;
  left: 72rpx;
  right: 28rpx;
  height: 1rpx;
  background: #dce2ea;
  content: "";
}

.row-icon {
  width: 38rpx;
  height: 38rpx;
}

.row-label,
.row-value {
  color: #1d2433;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.row-value {
  justify-self: end;
}

.notice-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 38rpx;
}

.notice-label {
  margin-top: 0;
}

.notice-version {
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.notice-card {
  margin-top: 24rpx;
  padding: 29rpx 28rpx 27rpx;
}

.notice-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-title {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 39rpx;
}

.notice-chevron,
.action-chevron {
  width: 34rpx;
  height: 34rpx;
}

.notice-date {
  margin-top: 15rpx;
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 33rpx;
}

.notice-divider {
  height: 1rpx;
  margin-top: 21rpx;
  background: #dce2ea;
}

.notice-item {
  margin-top: 22rpx;
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 35rpx;
}

.actions-heading {
  margin-top: 39rpx;
}

.action-card {
  margin-top: 24rpx;
}

.action-row {
  min-height: 71rpx;
}

.action-chevron {
  justify-self: end;
}
