.profile-edit-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 34rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.profile-edit-top {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.profile-preview {
  display: grid;
  grid-template-columns: 182rpx minmax(0, 1fr);
  column-gap: 35rpx;
  align-items: center;
  padding-top: 183rpx;
  padding-bottom: 54rpx;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 162rpx;
  height: 162rpx;
  color: #1d2433;
  background: #ebeff5;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-main {
  min-width: 0;
}

.profile-name {
  color: #1d2433;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 52rpx;
}

.profile-username {
  margin-top: 10rpx;
  color: #6b7385;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 178rpx;
  height: 46rpx;
  margin-top: 15rpx;
  padding: 0 27rpx;
  color: #a8661a;
  border: 1rpx solid #f3dcb5;
  border-radius: 999rpx;
  background: #fbeed8;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 46rpx;
  text-transform: lowercase;
}

.profile-divider {
  height: 1rpx;
  margin-right: -34rpx;
  margin-left: -34rpx;
  background: #dce2ea;
}

.profile-edit-section {
  padding-top: 38rpx;
}

.section-label {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 34rpx;
}

.profile-form-card {
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.64);
}

.form-row {
  position: relative;
  display: grid;
  grid-template-columns: 126rpx minmax(0, 1fr) 84rpx;
  column-gap: 26rpx;
  align-items: center;
  min-height: 120rpx;
  padding: 0 27rpx;
  border-bottom: 1rpx solid #dce2ea;
}

.form-row--bio {
  align-items: start;
  min-height: 284rpx;
  padding-top: 31rpx;
  padding-bottom: 31rpx;
}

.form-row--last {
  border-bottom: 0;
}

.form-label {
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.form-label--top {
  padding-top: 10rpx;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  color: #3a4254;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 29rpx;
  font-weight: 400;
}

.form-input {
  height: 68rpx;
  padding: 0 22rpx;
  font-size: 29rpx;
  line-height: 68rpx;
}

.form-input--readonly {
  color: #6b7385;
  background: rgba(248, 248, 248, 0.78);
}

.form-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 214rpx;
  padding: 21rpx 22rpx 42rpx;
  color: #3a4254;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 29rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.form-count {
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: right;
}

.form-count--bio {
  position: absolute;
  right: 49rpx;
  bottom: 47rpx;
}

.footer-spacer {
  height: 232rpx;
}

.profile-edit-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: grid;
  box-sizing: border-box;
  row-gap: 24rpx;
  padding: 38rpx 124rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #ebeff5;
}

.save-button {
  height: 80rpx;
  margin: 0;
  padding: 0;
  color: #1d2433;
  background: transparent;
  border: 2rpx solid #1d2433;
  border-radius: 8rpx;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 80rpx;
}

.save-button::after {
  border: 0;
}

.save-button[disabled] {
  opacity: 0.55;
}

.cancel-button {
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-align: center;
}
