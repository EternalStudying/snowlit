.feedback-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 48rpx 64rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
}

.top-action {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.feedback-head {
  padding-top: 183rpx;
}

.section-line {
  width: 100%;
  height: 1rpx;
  background: #dce2ea;
}

.hero-line {
  margin-top: 31rpx;
}

.form-section {
  margin-top: 37rpx;
}

.form-section--field {
  margin-top: 38rpx;
}

.section-label {
  color: #1d2433;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 31rpx;
}

.required-star {
  color: #d64545;
  font-size: 28rpx;
  letter-spacing: 0;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 18rpx;
  margin-top: 21rpx;
}

.type-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  color: #1d2433;
  border: 1rpx solid #dce2ea;
  border-radius: 9rpx;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 34rpx;
  white-space: nowrap;
}

.type-chip--active {
  border-color: #1d2433;
  border-width: 2rpx;
  font-weight: 500;
}

.field-input,
.textarea-wrap {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  color: #1d2433;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
  background: #f3f6fa;
}

.field-input {
  height: 57rpx;
  padding: 0 27rpx;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 57rpx;
}

.field-input--muted {
  color: #6b7385;
}

.textarea-wrap {
  position: relative;
  min-height: 203rpx;
  padding: 20rpx 27rpx 46rpx;
}

.field-textarea {
  display: block;
  width: 100%;
  height: 120rpx;
  color: #1d2433;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 37rpx;
}

.content-count {
  position: absolute;
  right: 27rpx;
  bottom: 20rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.screenshots-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 39rpx;
}

.screenshots-label {
  line-height: 31rpx;
}

.screenshots-count {
  color: #6b7385;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.screenshot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 42rpx;
  margin: 21rpx 16rpx 0;
}

.screenshot-slot {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  border: 1rpx dashed #6b7385;
  border-radius: 9rpx;
}

.screenshot-slot--filled {
  border-style: solid;
  border-color: #dce2ea;
}

.screenshot-preview {
  width: 100%;
  height: 100%;
}

.screenshot-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 8rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.58);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.remove-screenshot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.72);
  border-radius: 50%;
  font-size: 26rpx;
  line-height: 34rpx;
}

.plus-icon {
  position: relative;
  width: 45rpx;
  height: 45rpx;
}

.plus-icon::before,
.plus-icon::after {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #555e70;
  content: "";
  transform: translate(-50%, -50%);
}

.plus-icon::before {
  width: 42rpx;
  height: 3rpx;
}

.plus-icon::after {
  width: 3rpx;
  height: 42rpx;
}

.slot-label {
  margin-top: 22rpx;
  color: #3a4254;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.screenshot-helper {
  margin-top: 18rpx;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 31rpx;
}

.system-section {
  margin-top: 37rpx;
}

.system-card {
  overflow: hidden;
  margin-top: 20rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 8rpx;
}

.system-row {
  position: relative;
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  column-gap: 20rpx;
  align-items: start;
  min-height: 54rpx;
  padding: 12rpx 27rpx;
}

.system-row + .system-row::before {
  position: absolute;
  top: 0;
  left: 27rpx;
  right: 27rpx;
  height: 1rpx;
  background: #dce2ea;
  content: "";
}

.system-label,
.system-value {
  color: #1d2433;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.system-value {
  min-width: 0;
  word-break: break-all;
}

.system-label {
  white-space: nowrap;
}

.feedback-message {
  margin-top: 28rpx;
  color: #555e70;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-align: center;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 65rpx;
  margin-top: 30rpx;
  padding: 0;
  color: #ffffff;
  background: #1d2433;
  border: 0;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 65rpx;
}

.submit-button--loading {
  opacity: 0.72;
}

.submit-button::after {
  border: 0;
}

.submit-note {
  margin-top: 17rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 30rpx;
  text-align: center;
}
