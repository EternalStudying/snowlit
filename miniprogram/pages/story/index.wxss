.story-map-page {
  position: relative;
  height: 100vh;
  overflow-x: hidden;
  overflow-y: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.top-action {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 30;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.map-stage {
  position: relative;
  overflow: hidden;
  background: #ebeff5;
}

.native-map {
  width: 100%;
  height: 100%;
}

.filter-area {
  position: relative;
  z-index: 35;
  background: #ebeff5;
}

.category-row {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: #ebeff5;
}

.category-item {
  position: relative;
  color: #6b7385;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-align: center;
}

.category-item--active {
  color: #1d2433;
  font-weight: 600;
}

.category-line {
  position: absolute;
  left: 50%;
  bottom: -15rpx;
  width: 38rpx;
  height: 3rpx;
  background: #1d2433;
  transform: translateX(-50%);
}

.year-dropdown {
  position: absolute;
  top: 76rpx;
  left: 28rpx;
  right: 28rpx;
  z-index: 3;
  overflow: hidden;
  background: #ebeff5;
  border: 1rpx solid #dce2ea;
  border-radius: 0 0 18rpx 18rpx;
  box-shadow: 0 14rpx 28rpx rgba(29, 36, 51, 0.1);
}

.year-dropdown__inner {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding: 18rpx 20rpx 20rpx;
  white-space: nowrap;
}

.year-chip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 20rpx;
  color: #6b7385;
  background: #ffffff;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1;
}

.year-chip--active {
  color: #ffffff;
  background: #1d2433;
  border-color: #1d2433;
}

.story-add {
  position: fixed;
  right: 44rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #1d2433;
  box-shadow: 0 12rpx 26rpx rgba(29, 36, 51, 0.24);
}

.story-add__icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}

.moment-sheet-frame {
  position: relative;
  z-index: 16;
  overflow: hidden;
}

.moment-sheet {
  position: relative;
  box-sizing: border-box;
  padding: 40rpx 48rpx 8rpx;
  background: #ffffff;
  border-radius: 0;
  box-shadow: 0 -10rpx 26rpx rgba(29, 36, 51, 0.05);
}

.story-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  color: #6b7385;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
}

.story-state--error {
  flex-direction: column;
}

.state-action {
  height: 48rpx;
  margin-top: 18rpx;
  padding: 0 26rpx;
  color: #1d2433;
  border: 1rpx solid #1d2433;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 48rpx;
}

.moment-row {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  border-bottom: 1rpx solid #dce2ea;
}

.moment-row--selected {
  min-height: 158rpx;
}

.moment-date {
  flex: 0 0 112rpx;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.moment-main {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 22rpx;
}

.moment-title {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.moment-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: #6b7385;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.meta-pin {
  width: 21rpx;
  height: 21rpx;
  margin-right: 7rpx;
  opacity: 0.58;
}

.meta-dot {
  margin: 0 12rpx;
  color: #6b7385;
}

.category-tag {
  height: 28rpx;
  padding: 0 10rpx;
  background: #ebeff5;
  border-radius: 999rpx;
  color: #6b7385;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: center;
}

.moment-summary {
  margin-top: 6rpx;
  color: #6b7385;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.moment-thumb {
  flex: 0 0 142rpx;
  width: 142rpx;
  height: 104rpx;
  border-radius: 8rpx;
}
