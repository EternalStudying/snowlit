.top-scroll-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  height: 150rpx;
  background: rgba(243, 246, 250, 0.96);
}

.top-action {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 30;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

/* A second-level page: content starts below the back button, like the other second-level pages.
 * Overflow stays visible so the month headings can stick to the page's own scroll. */
.story-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 183rpx 44rpx calc(160rpx + env(safe-area-inset-bottom));
  color: #1d2433;
  background: #f3f6fa;
}

/* The map view fills the screen below the heading and filters; the page itself doesn't scroll. */
.story-page--map {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  overflow: hidden;
}

.story-heading {
  position: relative;
}

.hairline {
  width: 100%;
  height: 1rpx;
  background: #dce2ea;
}

.hero-line {
  margin-top: 42rpx;
}

/* 列表 / 地图: a quiet two-way switch on the title line. */
.view-switch {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  display: flex;
  padding: 4rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.view-switch__item {
  min-width: 72rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
  transition: background 180ms ease, color 180ms ease;
}

.view-switch__item--active {
  color: #ffffff;
  background: #1d2433;
}

.filter-row {
  display: flex;
  flex: none;
  align-items: flex-end;
  justify-content: space-between;
  height: 93rpx;
}

.filter-item {
  position: relative;
  padding-bottom: 24rpx;
  color: #6b7385;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.filter-item--active {
  color: #1d2433;
  font-weight: 600;
}

.filter-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: #1d2433;
}

.story-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  color: #6b7385;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
}

.state-action {
  height: 48rpx;
  margin-top: 18rpx;
  padding: 0 26rpx;
  color: #1d2433;
  border: 1rpx solid #1d2433;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 48rpx;
}

/* The month heading sticks under the top mask until the next month pushes it off. */
.month-head {
  position: sticky;
  top: 150rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid #dce2ea;
  background: #f3f6fa;
}

.month-head__title {
  display: flex;
  align-items: center;
  color: #1d2433;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  line-height: 40rpx;
}

.month-head__dot {
  margin: 0 10rpx;
  color: #6b7385;
}

.month-head__chevron {
  width: 10rpx;
  height: 10rpx;
  margin: -6rpx 0 0 16rpx;
  border-right: 2rpx solid #6b7385;
  border-bottom: 2rpx solid #6b7385;
  transform: rotate(45deg);
}

.month-head__count {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.moment-row {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  border-bottom: 1rpx solid #dce2ea;
}

.moment-date {
  flex: 0 0 120rpx;
  color: #6b7385;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
}

.moment-main {
  flex: 1 1 auto;
  min-width: 0;
  padding: 24rpx 22rpx 24rpx 0;
}

.moment-title {
  overflow: hidden;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-meta {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 12rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.meta-pin {
  flex: none;
  width: 21rpx;
  height: 21rpx;
  margin-right: 6rpx;
  opacity: 0.58;
}

.meta-dot {
  flex: none;
  margin: 0 10rpx;
  color: #6b7385;
}

.meta-place {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-tag {
  flex: none;
  height: 30rpx;
  padding: 0 12rpx;
  background: #ebeff5;
  border-radius: 999rpx;
  color: #6b7385;
  font-size: 20rpx;
  line-height: 30rpx;
}

.moment-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.moment-thumb {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 136rpx;
  border-radius: 10rpx;
  background: #ebeff5;
}

/* Map view: the map takes the rest of the screen; its size never changes while you use it. */
.map-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 24rpx -44rpx 0;
  overflow: hidden;
  background: #ebeff5;
}

.native-map {
  width: 100%;
  height: 100%;
}

.map-note {
  position: absolute;
  top: 20rpx;
  left: 50%;
  z-index: 5;
  padding: 0 22rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #6b7385;
  font-size: 22rpx;
  line-height: 52rpx;
  white-space: nowrap;
  transform: translateX(-50%);
}

.map-card {
  position: absolute;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 44rpx rgba(29, 36, 51, 0.16);
}

.map-card__photo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  margin-right: 22rpx;
  border-radius: 10rpx;
  background: #ebeff5;
}

.map-card__main {
  flex: 1;
  min-width: 0;
}

.map-card__title {
  overflow: hidden;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-card__meta {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  color: #6b7385;
  font-size: 22rpx;
  line-height: 30rpx;
}

.map-card__summary {
  overflow: hidden;
  margin-top: 8rpx;
  color: #6b7385;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-card__chevron {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  opacity: 0.6;
}

.story-add {
  position: fixed;
  right: 44rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #1d2433;
  box-shadow: 0 12rpx 26rpx rgba(29, 36, 51, 0.24);
}

.story-add__icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}
