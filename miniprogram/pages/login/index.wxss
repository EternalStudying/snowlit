.login-page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  overflow: hidden;
  background: #f8f8f8;
  color: #111111;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.login-title {
  position: absolute;
  top: 26.4vh;
  left: 0;
  width: 100%;
  color: #050505;
  font-size: 76rpx;
  font-weight: 300;
  letter-spacing: 18rpx;
  line-height: 1.2;
  text-align: center;
  transform: translateX(9rpx);
}

.login-subtitle {
  position: absolute;
  top: 34.5vh;
  left: 0;
  width: 100%;
  color: #777777;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 10rpx;
  line-height: 1;
  text-align: center;
  transform: translateX(5rpx);
}

.login-short-line {
  position: absolute;
  top: 45.7vh;
  left: 50%;
  width: 82rpx;
  height: 2rpx;
  background: #9d9d9d;
  transform: translateX(-50%);
}

.login-button {
  position: absolute;
  top: 54.9vh;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 520rpx;
  height: 104rpx;
  padding: 0;
  background: #050505;
  border-radius: 58rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 104rpx;
  text-align: center;
  transform: translateX(-50%);
}

.login-button--hover {
  background: #1a1a1a;
}

.wechat-icon {
  display: block;
  width: 54rpx;
  height: 54rpx;
  margin-right: 29rpx;
}

.login-button__text {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 1;
}

.bind-panel {
  position: absolute;
  top: 47.6vh;
  left: 50%;
  width: 560rpx;
  transform: translateX(-50%);
}

.bind-message {
  min-height: 48rpx;
  margin-bottom: 24rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 1.5;
  text-align: center;
}

.bind-input {
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  margin-top: 16rpx;
  padding: 0 30rpx;
  background: #ffffff;
  border: 1rpx solid #d7d7d7;
  border-radius: 0;
  color: #111111;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 86rpx;
}

.bind-input__placeholder {
  color: #9a9a9a;
}

.bind-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  background: #050505;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 1;
  text-align: center;
}

.bind-button--hover {
  background: #1a1a1a;
}

.bind-button--disabled {
  opacity: 0.58;
}

.bind-secondary {
  height: 54rpx;
  margin-top: 12rpx;
  color: #777777;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 54rpx;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 8rpx;
}

.bind-secondary--hover {
  color: #111111;
}

.public-link {
  position: absolute;
  top: 65.9vh;
  left: 50%;
  min-width: 260rpx;
  height: 58rpx;
  padding: 0 4rpx;
  color: #555555;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 58rpx;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 8rpx;
  transform: translateX(-50%);
}

.public-link--hover {
  color: #111111;
}

.public-link--bind {
  top: 77.8vh;
}

.login-bottom-line {
  position: absolute;
  top: 82.6vh;
  left: 50%;
  width: 520rpx;
  height: 1rpx;
  background: #d0d0d0;
  transform: translateX(-50%);
}

.agreement-section {
  position: absolute;
  top: 86.2vh;
  left: 0;
  width: 100%;
  min-height: 56rpx;
  padding: 0 54rpx;
  box-sizing: border-box;
  color: #848484;
  background: transparent;
  border-radius: 0;
  font-size: 23rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 34rpx;
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  min-height: 56rpx;
}

.agreement-check {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.agreement-checkbox {
  transform: scale(0.72);
  transform-origin: center;
}

.agreement-text {
  color: #848484;
}

.agreement-link {
  color: #050505;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.agreement-link--hover {
  color: #111111;
}
