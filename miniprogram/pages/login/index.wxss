.login-page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  overflow: hidden;
  background: #f3f6fa;
  color: #1d2433;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.login-title {
  position: absolute;
  top: 26.4vh;
  left: 0;
  width: 100%;
  color: #1d2433;
  font-size: 84rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-align: center;
  text-transform: lowercase;
}

.login-subtitle {
  position: absolute;
  top: 34.5vh;
  left: 0;
  width: 100%;
  color: #6b7385;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 1;
  text-align: center;
}

.login-short-line {
  position: absolute;
  top: 45.7vh;
  left: 50%;
  width: 82rpx;
  height: 2rpx;
  background: #6b7385;
  transform: translateX(-50%);
}

.login-button {
  position: absolute;
  top: 54.9vh;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 520rpx;
  height: 104rpx;
  padding: 0;
  background: #1d2433;
  border-radius: 58rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 104rpx;
  text-align: center;
  transform: translateX(-50%);
}

.login-button--hover {
  background: #1d2433;
}

.wechat-icon {
  display: block;
  width: 54rpx;
  height: 54rpx;
  margin-right: 29rpx;
}

.login-button__text {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 1;
}

.bind-panel {
  position: absolute;
  top: 47.6vh;
  left: 50%;
  width: 560rpx;
  transform: translateX(-50%);
}

.bind-message {
  min-height: 48rpx;
  margin-bottom: 24rpx;
  color: #555e70;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 1.5;
  text-align: center;
}

.bind-input {
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  margin-top: 16rpx;
  padding: 0 30rpx;
  background: #ffffff;
  border: 1rpx solid #dce2ea;
  border-radius: 0;
  color: #1d2433;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 86rpx;
}

.bind-input__placeholder {
  color: #6b7385;
}

.bind-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  background: #1d2433;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 1;
  text-align: center;
}

.bind-button--hover {
  background: #1d2433;
}

.bind-button--disabled {
  opacity: 0.58;
}

.bind-secondary {
  height: 54rpx;
  margin-top: 12rpx;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 54rpx;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 8rpx;
}

.bind-secondary--hover {
  color: #1d2433;
}

.public-link {
  position: absolute;
  top: 65.9vh;
  left: 50%;
  min-width: 260rpx;
  height: 58rpx;
  padding: 0 4rpx;
  color: #555e70;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 58rpx;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 8rpx;
  transform: translateX(-50%);
}

.public-link--hover {
  color: #1d2433;
}

.public-link--bind {
  top: 77.8vh;
}

.login-bottom-line {
  position: absolute;
  top: 82.6vh;
  left: 50%;
  width: 520rpx;
  height: 1rpx;
  background: #dce2ea;
  transform: translateX(-50%);
}

.agreement-section {
  position: absolute;
  top: 86.2vh;
  left: 0;
  width: 100%;
  min-height: 56rpx;
  padding: 0 54rpx;
  box-sizing: border-box;
  color: #6b7385;
  background: transparent;
  border-radius: 0;
  font-size: 23rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 34rpx;
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  min-height: 56rpx;
}

.agreement-check {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.agreement-checkbox {
  transform: scale(0.72);
  transform-origin: center;
}

.agreement-text {
  color: #6b7385;
}

.agreement-link {
  color: #1d2433;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.agreement-link--hover {
  color: #1d2433;
}

/* The lamp: a single lit point beside the wordmark. */
.login-title::after {
  content: "";
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #e8a23a;
  box-shadow: 0 0 24rpx rgba(232, 162, 58, 0.6);
  vertical-align: 6rpx;
}
