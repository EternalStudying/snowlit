.top-scroll-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  height: 128rpx;
  background: rgba(243, 246, 250, 0.96);
}

.hairline {
  width: 100%;
  height: 1rpx;
  background: #dce2ea;
}

.hero-line {
  margin-top: 42rpx;
}

.wish-add {
  position: fixed;
  right: 44rpx;
  bottom: calc(142rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #1d2433;
  box-shadow: 0 12rpx 26rpx rgba(29, 36, 51, 0.24);
}

.wish-add__icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}

.wishes-section {
  padding-top: 45rpx;
}

.wishes-section--next {
  padding-top: 44rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-label {
  color: #1d2433;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: 5rpx;
  line-height: 34rpx;
}

.section-state {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.wish-list {
  margin-top: 28rpx;
}

.section-message {
  min-height: 92rpx;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 92rpx;
}

.wish-row {
  position: relative;
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr) auto 30rpx;
  column-gap: 23rpx;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #dce2ea;
  transition: opacity 220ms ease, transform 220ms ease;
}

.wish-check {
  position: relative;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #1d2433;
  border-radius: 50%;
  background: transparent;
  transition: background 180ms ease, border-color 180ms ease;
}

.wish-check--done {
  border-color: #1d2433;
  background: #1d2433;
}

.wish-check-mark {
  position: absolute;
  top: 8rpx;
  left: 7rpx;
  width: 15rpx;
  height: 8rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.wish-row--leaving {
  opacity: 0;
  transform: translateY(-8rpx) scale(0.98);
}

.wish-content {
  min-width: 0;
}

.wish-title-cell {
  min-width: 0;
  overflow: hidden;
  color: #1d2433;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-date {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-align: right;
  white-space: nowrap;
}

.row-chevron,
.done-chevron {
  width: 31rpx;
  height: 31rpx;
  opacity: 0.82;
}

.done-section {
  padding-top: 44rpx;
}

.done-list {
  margin-top: 28rpx;
}

.load-more {
  height: 76rpx;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 76rpx;
  text-align: center;
}

.done-row {
  position: relative;
  display: grid;
  grid-template-columns: 264rpx minmax(0, 1fr) 31rpx;
  column-gap: 32rpx;
  align-items: center;
  min-height: 162rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #dce2ea;
  transition: opacity 220ms ease, transform 220ms ease;
}

.done-row--leaving {
  opacity: 0;
  transform: translateY(-8rpx) scale(0.98);
}

.done-photo-wrap {
  position: relative;
  width: 264rpx;
  height: 165rpx;
}

.done-photo {
  display: block;
  width: 100%;
  height: 100%;
  background: #ebeff5;
  border-radius: 8rpx;
}

.done-check {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  width: 33rpx;
  height: 33rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: rgba(29, 36, 51, 0.58);
}

.done-check-mark {
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 15rpx;
  height: 8rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.done-content {
  min-width: 0;
}

.done-title {
  overflow: hidden;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.done-date {
  margin-top: 25rpx;
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 31rpx;
}
