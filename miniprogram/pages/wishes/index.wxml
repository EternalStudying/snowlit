<view class="wishes-page snowlit-tab-page">
  <view class="top-scroll-mask" wx:if="{{showTopMask}}"></view>

  <view class="snowlit-page-heading">
    <view class="snowlit-page-brand">SNOWLIT</view>
    <view class="snowlit-page-title">清单</view>
    <view class="snowlit-page-subtitle">把想去和想做慢慢实现</view>
  </view>

  <view class="hairline hero-line"></view>

  <view class="wish-add" wx:if="{{canManage}}" bindtap="goCreate">
    <image class="wish-add__icon" src="../../assets/icons/story/plus-white.svg" mode="aspectFit" />
  </view>

  <view class="wishes-section">
    <view class="section-heading">
      <view class="section-label">WANT TO GO</view>
      <view class="section-state">{{counts.wantGo}}</view>
    </view>

    <view class="wish-list">
      <view class="section-message" wx:if="{{pageState.wantGo.loading && !wantGoWishes.length}}">清单加载中...</view>
      <view class="section-message" wx:if="{{!pageState.wantGo.loading && pageState.wantGo.message}}">{{pageState.wantGo.message}}</view>
      <block wx:if="{{wantGoWishes.length}}">
        <view
          class="wish-row {{item.stateClass}}"
          wx:for="{{wantGoWishes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openWish"
        >
          <view
            class="wish-check {{item.checkClass}}"
            data-id="{{item.id}}"
            data-section="wantGo"
            catchtap="completeWish"
          >
            <view wx:if="{{item.checkClass}}" class="wish-check-mark"></view>
          </view>
          <view class="wish-content">
            <view class="wish-title-cell">{{item.title}}</view>
          </view>
          <view class="wish-date">{{item.createdDate}} 创建</view>
          <image class="row-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
        </view>
      </block>
      <view class="load-more" wx:if="{{wantGoWishes.length && pageState.wantGo.hasMore && !pageState.wantGo.loading}}" bindtap="loadMoreWantGo">加载更多</view>
      <view class="load-more" wx:if="{{wantGoWishes.length && pageState.wantGo.loading}}">加载中...</view>
    </view>
  </view>

  <view class="wishes-section wishes-section--next">
    <view class="section-heading">
      <view class="section-label">WANT TO DO</view>
      <view class="section-state">{{counts.wantDo}}</view>
    </view>

    <view class="wish-list">
      <view class="section-message" wx:if="{{pageState.wantDo.loading && !wantDoWishes.length}}">清单加载中...</view>
      <view class="section-message" wx:if="{{!pageState.wantDo.loading && pageState.wantDo.message}}">{{pageState.wantDo.message}}</view>
      <block wx:if="{{wantDoWishes.length}}">
        <view
          class="wish-row {{item.stateClass}}"
          wx:for="{{wantDoWishes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openWish"
        >
          <view
            class="wish-check {{item.checkClass}}"
            data-id="{{item.id}}"
            data-section="wantDo"
            catchtap="completeWish"
          >
            <view wx:if="{{item.checkClass}}" class="wish-check-mark"></view>
          </view>
          <view class="wish-content">
            <view class="wish-title-cell">{{item.title}}</view>
          </view>
          <view class="wish-date">{{item.createdDate}} 创建</view>
          <image class="row-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
        </view>
      </block>
      <view class="load-more" wx:if="{{wantDoWishes.length && pageState.wantDo.hasMore && !pageState.wantDo.loading}}" bindtap="loadMoreWantDo">加载更多</view>
      <view class="load-more" wx:if="{{wantDoWishes.length && pageState.wantDo.loading}}">加载中...</view>
    </view>
  </view>

  <view class="done-section">
    <view class="section-heading">
      <view class="section-label">DONE</view>
      <view class="section-state">{{counts.done}}</view>
    </view>

    <view class="done-list">
      <view class="section-message" wx:if="{{pageState.completed.loading && !completedWishes.length}}">清单加载中...</view>
      <view class="section-message" wx:if="{{!pageState.completed.loading && pageState.completed.message}}">{{pageState.completed.message}}</view>
      <block wx:if="{{completedWishes.length}}">
        <view
          class="done-row {{item.stateClass}}"
          wx:for="{{completedWishes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openWish"
        >
          <view class="done-photo-wrap">
            <image class="done-photo" src="{{item.image}}" mode="aspectFill" />
            <view class="done-check" data-id="{{item.id}}" catchtap="reopenWish">
              <view class="done-check-mark"></view>
            </view>
          </view>
          <view class="done-content">
            <view class="done-title">{{item.title}}</view>
            <view class="done-date">{{item.completedDate}} 完成</view>
          </view>
          <image class="done-chevron" src="../../assets/icons/home/chevron-right.svg" mode="aspectFit" />
        </view>
      </block>
      <view class="load-more" wx:if="{{completedWishes.length && pageState.completed.hasMore && !pageState.completed.loading}}" bindtap="loadMoreCompleted">加载更多</view>
      <view class="load-more" wx:if="{{completedWishes.length && pageState.completed.loading}}">加载中...</view>
    </view>

    <view
      class="snowlit-end-tip"
      wx:if="{{!pageState.wantGo.hasMore && !pageState.wantDo.hasMore && !pageState.completed.hasMore && !pageState.wantGo.loading && !pageState.wantDo.loading && !pageState.completed.loading}}"
    >
      没有更多了哦~
    </view>
  </view>
</view>

<snowlit-toast id="snowlit-toast" />
<snowlit-dialog id="snowlit-dialog" />
<snowlit-privacy id="snowlit-privacy" />
<wish-completion-sheet
  visible="{{completionSheetVisible}}"
  submitting="{{completionSubmitting}}"
  bindconfirm="confirmCompleteWish"
  bindmissing="handleCompletionImageMissing"
  bindcancel="closeCompletionSheet"
/>
