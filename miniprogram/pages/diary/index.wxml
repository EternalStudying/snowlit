<view class="top-scroll-mask" wx:if="{{showTopMask}}"></view>

<view class="diary-page snowlit-tab-page">
  <view class="snowlit-page-heading">
    <view class="snowlit-page-brand">SNOWLIT</view>
    <view class="snowlit-page-title snowlit-kai">日记</view>
    <view class="snowlit-page-subtitle">
      <view class="snowlit-subtitle-rule"></view>
      <text class="snowlit-subtitle-text snowlit-kai">墨痕半页，皆是心事</text>
    </view>
  </view>

  <view class="hairline hero-line"></view>

  <view class="filter-row">
    <view
      class="filter-item {{activeFilter === item.value ? 'filter-item--active' : ''}}"
      wx:for="{{filters}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="handleFilterTap"
    >
      <text>{{item.label}}</text>
      <view wx:if="{{activeFilter === item.value}}" class="filter-line snowlit-grow"></view>
    </view>
  </view>

  <view class="hairline"></view>

  <view class="entries-section">
    <view class="entry-state" wx:if="{{loading}}">日记加载中...</view>
    <view class="entry-state" wx:elif="{{message}}">{{message}}</view>
    <view class="entry-state" wx:elif="{{exhausted && !sections.length}}">还没有日记，写下第一篇吧</view>

    <view
      class="month-block snowlit-reveal"
      wx:for="{{sections}}"
      wx:for-item="section"
      wx:key="month"
      id="{{section.anchorId}}"
    >
      <view class="month-head" hover-class="snowlit-pressed" data-month="{{section.month}}" bindtap="handleMonthHeadTap">
        <view class="month-head__title snowlit-serif">
          <text>{{section.yearText}}</text>
          <text class="month-head__dot">·</text>
          <text>{{section.monthText}}</text>
          <view class="month-head__chevron"></view>
        </view>
        <view class="month-head__count snowlit-serif">{{section.countText}}</view>
      </view>

      <view class="entry-state entry-state--muted" wx:if="{{!section.entries.length}}">这个月没有符合的日记</view>

      <view
        class="entry-row snowlit-reveal"
        hover-class="snowlit-pressed"
        style="animation-delay: {{index < 8 ? index * 45 : 0}}ms"
        wx:for="{{section.entries}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleEntryTap"
      >
        <view class="entry-date-cell">
          <view class="entry-date snowlit-serif">{{item.date}}</view>
          <view class="entry-visibility">{{item.visibility}}</view>
        </view>
        <view class="entry-main">
          <view class="entry-title">{{item.title}}</view>
          <view class="entry-summary">{{item.summary}}</view>
          <view class="entry-meta">{{item.meta}}</view>
        </view>
        <view class="entry-aside" wx:if="{{item.image}}">
          <image
            class="entry-thumb"
            src="{{item.image}}"
            mode="aspectFill"
            lazy-load
          />
        </view>
      </view>
    </view>

    <view class="entry-state" wx:if="{{loadingMore}}">日记加载中...</view>
    <view class="entry-state entry-retry" hover-class="snowlit-pressed" wx:elif="{{failedMonth}}" bindtap="handleRetryTap">这个月份加载失败，轻点重试</view>
    <view class="entry-state" wx:elif="{{exhausted && sections.length && !matching}}">没有符合的日记</view>
  </view>

  <view class="snowlit-end-tip" wx:if="{{exhausted && sections.length && !loadingMore}}">没有更多了哦~</view>
</view>

<view class="diary-add" hover-class="snowlit-pressed-round" bindtap="handleCreateDiary">
  <image class="diary-add__icon" src="../../assets/icons/story/plus-white.svg" mode="aspectFit" />
</view>

<snowlit-toast id="snowlit-toast" />
<snowlit-dialog id="snowlit-dialog" />

<snowlit-month-sheet
  visible="{{jumpVisible}}"
  years="{{jumpYears}}"
  bind:select="handleJumpSelect"
  bind:cancel="handleJumpCancel"
/>
