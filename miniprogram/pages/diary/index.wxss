.top-scroll-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  height: 128rpx;
  background: rgba(243, 246, 250, 0.96);
}

.hairline {
  width: 100%;
  height: 1rpx;
  background: #dce2ea;
}

.hero-line {
  margin-top: 42rpx;
}

/* Visible overflow, so the month headings can stick to the page's own scroll. */
.diary-page {
  overflow: visible;
}

.filter-row {
  display: flex;
  align-items: flex-end;
  height: 93rpx;
}

.filter-item {
  position: relative;
  min-width: 92rpx;
  margin-right: 28rpx;
  padding-bottom: 24rpx;
  color: #6b7385;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.filter-item--active {
  color: #1d2433;
  font-weight: 600;
}

.filter-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 48rpx;
  height: 3rpx;
  background: #1d2433;
}

.entries-section {
  padding-top: 12rpx;
}

/* The month heading sticks under the top mask until the next month pushes it off. */
.month-head {
  position: sticky;
  top: 128rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid #dce2ea;
  background: #f3f6fa;
}

.month-head__title {
  display: flex;
  align-items: center;
  color: #1d2433;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  line-height: 40rpx;
}

.month-head__dot {
  margin: 0 10rpx;
  color: #6b7385;
}

/* A small down-chevron: the heading opens the month sheet. */
.month-head__chevron {
  width: 10rpx;
  height: 10rpx;
  margin: -6rpx 0 0 16rpx;
  border-right: 2rpx solid #6b7385;
  border-bottom: 2rpx solid #6b7385;
  transform: rotate(45deg);
}

.month-head__count {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.entry-state {
  padding: 38rpx 0;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 34rpx;
}

.entry-state--muted {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #dce2ea;
}

.entry-retry {
  text-align: center;
}

.entry-row {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  border-bottom: 1rpx solid #dce2ea;
}

.entry-date-cell {
  flex: 0 0 136rpx;
}

.entry-date {
  color: #6b7385;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
}

.entry-visibility {
  margin-top: 18rpx;
  color: #6b7385;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  line-height: 22rpx;
}

.entry-main {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 22rpx;
}

.entry-title {
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.entry-summary {
  margin-top: 17rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.entry-meta {
  margin-top: 17rpx;
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 28rpx;
}

.entry-aside {
  display: flex;
  flex: 0 0 126rpx;
  justify-content: flex-end;
}

.entry-thumb {
  width: 124rpx;
  height: 124rpx;
  border-radius: 8rpx;
}

.diary-add {
  position: fixed;
  right: 44rpx;
  bottom: calc(142rpx + env(safe-area-inset-bottom));
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #1d2433;
  border-radius: 50%;
  box-shadow: 0 14rpx 28rpx rgba(29, 36, 51, 0.22);
}

.diary-add__icon {
  width: 36rpx;
  height: 36rpx;
}
