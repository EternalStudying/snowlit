.top-scroll-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  height: 128rpx;
  background: rgba(251, 251, 251, 0.96);
}

.hairline {
  width: 100%;
  height: 1rpx;
  background: #d8d8d8;
}

.hero-line {
  margin-top: 42rpx;
}

.month-section {
  padding-top: 42rpx;
}

.section-label {
  color: #8a8a8a;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  line-height: 22rpx;
}

.month-overview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 111rpx;
  padding-top: 20rpx;
}

.month-title {
  color: #050505;
  font-size: 42rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 50rpx;
}

.month-caption {
  margin-top: 13rpx;
  color: #777777;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.month-scroll {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100rpx;
  white-space: nowrap;
}

.month-tab {
  position: relative;
  flex: 0 0 calc((100vw - 88rpx) / 4);
  width: calc((100vw - 88rpx) / 4);
  height: 100rpx;
  padding-top: 44rpx;
  color: #777777;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
}

.month-tab--active {
  color: #050505;
}

.month-tab-line {
  width: 40rpx;
  height: 4rpx;
  margin: 15rpx auto 0;
  background: #111111;
}

.stat-row {
  display: flex;
  align-items: center;
  height: 150rpx;
}

.stat-item {
  position: relative;
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item::before {
  position: absolute;
  top: 10rpx;
  left: 0;
  width: 1rpx;
  height: 70rpx;
  background: #d8d8d8;
  content: "";
}

.stat-label {
  color: #777777;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.stat-value {
  margin-top: 14rpx;
  color: #050505;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 44rpx;
}

.filter-row {
  display: flex;
  align-items: flex-end;
  height: 93rpx;
}

.filter-item {
  position: relative;
  min-width: 92rpx;
  margin-right: 28rpx;
  padding-bottom: 24rpx;
  color: #777777;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.filter-item--active {
  color: #050505;
  font-weight: 600;
}

.filter-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 48rpx;
  height: 3rpx;
  background: #111111;
}

.entries-section {
  padding-top: 43rpx;
}

.entry-list {
  margin-top: 24rpx;
}

.entry-state {
  padding: 38rpx 0;
  color: #777777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.entry-row {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  border-bottom: 1rpx solid #dedede;
}

.entry-date-cell {
  flex: 0 0 136rpx;
}

.entry-date {
  color: #777777;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
}

.entry-visibility {
  margin-top: 18rpx;
  color: #9a9a9a;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  line-height: 22rpx;
}

.entry-main {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 22rpx;
}

.entry-title {
  color: #050505;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.entry-summary {
  margin-top: 17rpx;
  color: #777777;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.entry-meta {
  margin-top: 17rpx;
  color: #777777;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 28rpx;
}

.entry-aside {
  display: flex;
  flex: 0 0 126rpx;
  justify-content: flex-end;
}

.entry-thumb {
  width: 124rpx;
  height: 124rpx;
  border-radius: 8rpx;
}

.diary-add {
  position: fixed;
  right: 44rpx;
  bottom: calc(142rpx + env(safe-area-inset-bottom));
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #050505;
  border-radius: 50%;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.22);
}

.diary-add__icon {
  width: 36rpx;
  height: 36rpx;
}
