.story-edit-page {
  position: relative;
  min-height: 100vh;
  padding: 0 50rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
}

.story-edit-top {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.section-line {
  height: 1rpx;
  background: #dce2ea;
}

.edit-section {
  padding-top: 33rpx;
}

.edit-section--basic {
  padding-top: 183rpx;
}

.section-label {
  color: #6b7385;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 34rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #dce2ea;
}

.row-label {
  flex: 0 0 auto;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.row-right {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.row-value {
  max-width: 520rpx;
  overflow: hidden;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-value--time,
.row-value--coordinate {
  letter-spacing: 1rpx;
}

.row-value--address {
  max-width: 440rpx;
}

.row-input {
  width: 100%;
  height: 72rpx;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: right;
}

.row-input--address {
  max-width: 440rpx;
}

.picker-group {
  column-gap: 18rpx;
}

.end-time-label {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.picker-value {
  min-width: 170rpx;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: right;
}

.picker-value--time {
  min-width: 96rpx;
}

.picker-group--end .picker-value {
  color: #555e70;
}

.clear-time {
  flex: 0 0 auto;
  margin-left: 22rpx;
  color: #6b7385;
  font-size: 23rpx;
  line-height: 36rpx;
}

.coordinate-group {
  column-gap: 10rpx;
}

.coordinate-input {
  width: 136rpx;
  height: 72rpx;
  color: #1d2433;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: right;
}

.coordinate-separator {
  color: #6b7385;
  font-size: 27rpx;
  line-height: 72rpx;
}

.chevron-icon {
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  margin-left: 16rpx;
  opacity: 0.72;
}

.category-row {
  min-height: 90rpx;
}

.category-list {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  margin-left: 72rpx;
}

.category-item {
  position: relative;
  height: 62rpx;
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 62rpx;
  text-align: center;
}

.category-item--active::after {
  position: absolute;
  right: 24rpx;
  bottom: 2rpx;
  left: 24rpx;
  height: 4rpx;
  background: #1d2433;
  content: "";
}

.edit-section--location {
  padding-top: 30rpx;
}

.map-preview {
  position: relative;
  height: 143rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 0;
  background: #ebeff5;
}

.map-image {
  width: 100%;
  height: 100%;
  opacity: 0.66;
}

.map-preview::after {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.28);
  content: "";
}

.map-pin {
  position: absolute;
  top: 50rpx;
  left: 319rpx;
  z-index: 2;
  width: 46rpx;
  height: 46rpx;
}

.map-pick {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  color: #3a4254;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.map-pick-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.edit-section--words {
  margin-top: 31rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #dce2ea;
}

.words-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 30rpx;
  padding-bottom: 26rpx;
  color: #1d2433;
  border-bottom: 1rpx solid #dce2ea;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 45rpx;
}

.edit-section--photos {
  padding-top: 30rpx;
}

.photos-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-label--photos {
  line-height: 28rpx;
}

.photos-limit {
  color: #6b7385;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.photo-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 13rpx;
  margin-top: 19rpx;
}

.photo-wrap,
.photo-add {
  width: 100%;
  height: 182rpx;
  overflow: hidden;
  border-radius: 9rpx;
}

.photo-wrap {
  position: relative;
  background: #ebeff5;
}

.photo-item {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 3;
  width: 38rpx;
  height: 38rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.72);
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.photo-status {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  height: 38rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.58);
  font-size: 20rpx;
  line-height: 38rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1d2433;
  background: #ebeff5;
}

.photo-add-plus {
  height: 57rpx;
  font-size: 69rpx;
  font-weight: 200;
  line-height: 54rpx;
}

.photo-add-text {
  margin-top: 17rpx;
  color: #555e70;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.bottom-placeholder {
  height: 188rpx;
}

.edit-message {
  margin-top: 28rpx;
  color: #a8661a;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.action-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: 180rpx 1fr;
  column-gap: 28rpx;
  align-items: center;
  height: 148rpx;
  padding: 0 50rpx 22rpx;
  background: rgba(243, 246, 250, 0.96);
  border-top: 1rpx solid #dce2ea;
}

.cancel-button {
  color: #1d2433;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 92rpx;
  text-align: center;
}

.publish-button {
  height: 72rpx;
  color: #ffffff;
  background: #1d2433;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: center;
}

.publish-button::after {
  border: 0;
}

.publish-button[disabled] {
  opacity: 0.55;
}
