.story-edit-page {
  position: relative;
  min-height: 100vh;
  padding: 0 44rpx;
  overflow-x: hidden;
  color: #1d2433;
  background: #f3f6fa;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", Arial, sans-serif;
}

.story-edit-top {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.edit-section {
  padding-top: 36rpx;
}

/* Name and kind */
.edit-section--basic {
  padding-top: 183rpx;
}

.edit-kicker {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.edit-kicker__title {
  color: #6b7385;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  line-height: 36rpx;
}

.draft-status {
  color: #6b7385;
  font-size: 22rpx;
  line-height: 30rpx;
}

.title-input {
  height: 88rpx;
  margin-top: 14rpx;
  color: #1d2433;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.title-input__placeholder {
  color: rgba(29, 36, 51, 0.3);
  font-weight: 400;
}

.category-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.category-chip {
  height: 56rpx;
  padding: 0 26rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7385;
  font-size: 26rpx;
  line-height: 56rpx;
  transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
}

.category-chip--active {
  border-color: #1d2433;
  background: #1d2433;
  color: #ffffff;
}

/* Writing */
.edit-section--words {
  margin-top: 36rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #dce2ea;
}

.words-textarea {
  width: 100%;
  min-height: 220rpx;
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.words-textarea__placeholder {
  color: rgba(29, 36, 51, 0.3);
}

/* Photos */
.photo-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 14rpx;
}

.photo-wrap,
.photo-add {
  width: 100%;
  height: 200rpx;
  overflow: hidden;
  border-radius: 14rpx;
}

.photo-wrap {
  position: relative;
  background: #ebeff5;
}

.photo-item {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 3;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.68);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.photo-status {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  height: 40rpx;
  color: #ffffff;
  background: rgba(29, 36, 51, 0.58);
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #dce2ea;
  color: #6b7385;
}

.photo-add-plus {
  height: 52rpx;
  color: #1d2433;
  font-size: 60rpx;
  font-weight: 200;
  line-height: 50rpx;
}

.photo-add-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

/* When and where */
.detail-card {
  padding: 8rpx 28rpx 12rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.8);
}

.detail-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
}

.detail-label {
  flex: 0 0 96rpx;
  color: #1d2433;
  font-size: 28rpx;
  line-height: 36rpx;
}

.detail-label--muted {
  color: #6b7385;
}

.detail-value {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.detail-pick {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ebeff5;
  color: #1d2433;
  font-size: 27rpx;
  line-height: 56rpx;
}

.detail-clear {
  width: 44rpx;
  height: 44rpx;
  color: #6b7385;
  font-size: 32rpx;
  line-height: 42rpx;
  text-align: center;
}

.detail-link {
  padding: 4rpx 0 18rpx;
  color: #6b7385;
  font-size: 24rpx;
  line-height: 32rpx;
}

.detail-link--indent {
  padding-left: 96rpx;
}

.detail-divider {
  height: 1rpx;
  margin: 4rpx 0;
  background: #dce2ea;
}

.detail-row--place {
  align-items: flex-start;
  min-height: 0;
  padding: 28rpx 0 16rpx;
}

.detail-place {
  flex: 1;
  min-width: 0;
}

.detail-place__name {
  overflow: hidden;
  color: #1d2433;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-place__name--empty {
  color: rgba(29, 36, 51, 0.42);
  font-weight: 400;
}

.detail-place__sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #6b7385;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-chevron {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin: 6rpx 0 0 12rpx;
  opacity: 0.6;
}

.manual-place {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 4rpx 0 16rpx 96rpx;
}

.manual-coordinates {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 12rpx;
}

.manual-input {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ebeff5;
  color: #1d2433;
  font-size: 26rpx;
}

.bottom-placeholder {
  height: 188rpx;
}

.edit-message {
  margin-top: 28rpx;
  color: #a8661a;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.action-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: 160rpx 1fr;
  column-gap: 24rpx;
  align-items: center;
  padding: 20rpx 44rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(243, 246, 250, 0.96);
  border-top: 1rpx solid #dce2ea;
}

.cancel-button {
  color: #6b7385;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 88rpx;
  text-align: center;
}

.publish-button {
  height: 88rpx;
  color: #ffffff;
  background: #1d2433;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
  text-align: center;
}

.publish-button::after {
  border: 0;
}

.publish-button[disabled] {
  opacity: 0.55;
}

.draft-loading { position: fixed; top: 120rpx; left: 34rpx; right: 34rpx; z-index: 5; color: #687180; font-size: 24rpx; text-align: center; }
