<view class="story-edit-page">
  <view class="story-edit-top">
    <view class="back-button" bindtap="goBack">
      <image class="back-icon" src="../../assets/icons/story/chevron-left.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="edit-section edit-section--basic">
    <view class="section-label">BASIC</view>
    <view class="edit-row">
      <view class="row-label">标题</view>
      <view class="row-right">
        <input
          class="row-input"
          value="{{form.title}}"
          placeholder="输入标题"
          maxlength="30"
          data-field="title"
          bindinput="handleInput"
        />
      </view>
    </view>
    <view class="edit-row category-row">
      <view class="row-label">分类</view>
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="category-item {{item.active ? 'category-item--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleCategoryTap"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="edit-section">
    <view class="section-label">TIME</view>
    <view class="edit-row">
      <view class="row-label">开始时间</view>
      <view class="row-right picker-group">
        <view class="picker-value" data-field="eventDate" bindtap="openStoryDateSheet">{{form.eventDate}}</view>
        <view class="picker-value picker-value--time" data-field="eventTime" bindtap="openStoryTimeSheet">{{form.eventTime}}</view>
      </view>
    </view>
    <view class="edit-row edit-row--end-time">
      <view class="end-time-label">
        <view class="row-label">结束时间</view>
        <view class="clear-time" catchtap="clearEndTime">清空</view>
      </view>
      <view class="row-right picker-group picker-group--end">
        <view class="picker-value" data-field="endDate" bindtap="openStoryDateSheet">{{form.endDate || '不填写'}}</view>
        <view class="picker-value picker-value--time" data-field="endTime" bindtap="openStoryTimeSheet">{{form.endTime || '--:--'}}</view>
      </view>
    </view>
  </view>

  <view class="edit-section edit-section--location">
    <view class="section-label">LOCATION</view>
    <view class="edit-row">
      <view class="row-label">地点名称</view>
      <view class="row-right">
        <input
          class="row-input"
          value="{{form.locationName}}"
          placeholder="输入地点"
          maxlength="30"
          data-field="locationName"
          bindinput="handleInput"
        />
      </view>
    </view>
    <view class="edit-row">
      <view class="row-label">详细地址</view>
      <view class="row-right">
        <input
          class="row-input row-input--address"
          value="{{form.address}}"
          placeholder="输入地址"
          maxlength="80"
          data-field="address"
          bindinput="handleInput"
        />
      </view>
    </view>
    <view class="edit-row">
      <view class="row-label">经纬度</view>
      <view class="row-right coordinate-group">
        <input
          class="coordinate-input"
          value="{{form.longitude}}"
          placeholder="经度"
          data-field="longitude"
          bindinput="handleInput"
        />
        <view class="coordinate-separator">,</view>
        <input
          class="coordinate-input"
          value="{{form.latitude}}"
          placeholder="纬度"
          data-field="latitude"
          bindinput="handleInput"
        />
      </view>
    </view>
    <view class="map-preview">
      <image class="map-image" src="../../assets/story/map-preview.png" mode="aspectFill" />
      <image class="map-pin" src="../../assets/icons/story/map-pin-filled.svg" mode="aspectFit" />
      <view class="map-pick">
        <image class="map-pick-icon" src="../../assets/icons/story/current-location.svg" mode="aspectFit" />
        <text>手动填写坐标</text>
      </view>
    </view>
  </view>

  <view class="edit-section edit-section--words">
    <view class="section-label">WORDS</view>
    <textarea
      class="words-textarea"
      value="{{form.content}}"
      placeholder="写下这一天的细节"
      maxlength="1000"
      auto-height
      data-field="content"
      bindinput="handleInput"
    />
  </view>

  <view class="edit-section edit-section--photos">
    <view class="photos-head">
      <view class="section-label section-label--photos">PHOTOS</view>
      <view class="photos-limit">最多 3 张</view>
    </view>
    <view class="photo-list">
      <view wx:for="{{images}}" wx:key="id" class="photo-wrap">
        <image
          class="photo-item"
          src="{{item.path}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewPhoto"
        />
        <view class="photo-remove" data-index="{{index}}" catchtap="removeImage">x</view>
        <view class="photo-status" wx:if="{{item.message}}">{{item.message}}</view>
      </view>
      <view class="photo-add" wx:if="{{canAddImage}}" bindtap="chooseImages">
        <view class="photo-add-plus">+</view>
        <view class="photo-add-text">添加</view>
      </view>
    </view>
  </view>

  <view class="edit-message" wx:if="{{message}}">{{message}}</view>
  <view class="snowlit-end-tip snowlit-end-tip--compact">没有更多了哦~</view>
  <view class="bottom-placeholder"></view>

  <view class="action-footer">
    <view class="cancel-button" bindtap="goBack">取消</view>
    <button class="publish-button" loading="{{submitting}}" disabled="{{submitting || loadingMoment}}" bindtap="submitMoment">{{isEditing ? '保存修改' : '发布点滴'}}</button>
  </view>
</view>

<snowlit-toast id="snowlit-toast" />
<snowlit-dialog id="snowlit-dialog" />
<snowlit-privacy id="snowlit-privacy" />
<snowlit-date-sheet
  visible="{{dateSheetVisible}}"
  title="{{activePickerTitle}}"
  value="{{activePickerValue}}"
  bindconfirm="confirmStoryDateFromSheet"
  bindcancel="closeStoryDateSheet"
/>
<snowlit-time-sheet
  visible="{{timeSheetVisible}}"
  title="{{activePickerTitle}}"
  value="{{activePickerValue}}"
  bindconfirm="confirmStoryTimeFromSheet"
  bindcancel="closeStoryTimeSheet"
/>
