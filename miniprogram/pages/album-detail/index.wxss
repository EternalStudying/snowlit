.album-detail-page {
  min-height: 100vh;
  padding: 0 48rpx 72rpx;
  overflow-x: hidden;
  color: #050505;
  background: #fbfbfb;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.top-action {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 120rpx;
  height: 146rpx;
}

.back-button {
  position: absolute;
  top: 94rpx;
  left: 38rpx;
  width: 44rpx;
  height: 44rpx;
}

.back-icon {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
}

.album-head {
  padding-top: 183rpx;
}

.album-state {
  padding-top: 180rpx;
  color: #777777;
  font-size: 26rpx;
  line-height: 36rpx;
}

.album-locked {
  padding-top: 183rpx;
}

.album-badges {
  display: flex;
  align-items: center;
  margin-top: 31rpx;
}

.album-badge {
  min-width: 78rpx;
  height: 36rpx;
  margin-right: 17rpx;
  padding: 0 18rpx;
  color: #222222;
  border: 1rpx solid #d0d0d0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
}

.cover-frame {
  height: 409rpx;
  margin-top: 45rpx;
  margin-bottom: 27rpx;
}

.empty-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 409rpx;
  margin-top: 45rpx;
  margin-bottom: 27rpx;
  color: #777777;
  background: #eeeeee;
  border-radius: 9rpx;
  font-size: 24rpx;
}

.cover-photo {
  display: block;
  width: 100%;
  height: 100%;
  background: #eeeeee;
  border-radius: 9rpx;
}

.section-line {
  width: 100%;
  height: 1rpx;
  background: #d8d8d8;
}

.meta-row {
  display: grid;
  grid-template-columns: 1.24fr 1fr 1fr;
  height: 131rpx;
  align-items: stretch;
}

.meta-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  min-height: 0;
  min-width: 0;
}

.meta-label {
  color: #777777;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 26rpx;
}

.meta-value {
  margin-top: 13rpx;
  color: #050505;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  height: 120rpx;
  align-items: stretch;
}

.stat-cell {
  position: relative;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
}

.stat-cell + .stat-cell::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 1rpx;
  height: 35rpx;
  background: #d8d8d8;
  content: "";
  transform: translateY(-50%);
}

.stat-cell--left {
  justify-content: flex-start;
  padding-left: 20rpx;
}

.stat-cell--right {
  justify-content: flex-end;
  padding-right: 20rpx;
}

.stat-icon {
  width: 43rpx;
  height: 43rpx;
  margin-right: 22rpx;
  opacity: 0.7;
}

.stat-value {
  color: #050505;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.stat-cell--active .stat-icon {
  opacity: 1;
}

.stat-cell--active .stat-value {
  font-weight: 500;
}

.stat-cell--loading {
  opacity: 0.58;
}

.photos-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 31rpx;
}

.section-label {
  color: #777777;
  font-size: 21rpx;
  font-weight: 400;
  letter-spacing: 11rpx;
  line-height: 26rpx;
}

.photos-count {
  color: #777777;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 16rpx;
  row-gap: 24rpx;
  margin-top: 24rpx;
}

.photo-empty {
  padding: 36rpx 0 0;
  color: #777777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.photo-item {
  min-width: 0;
}

.photo-image {
  display: block;
  width: 100%;
  height: 199rpx;
  background: #eeeeee;
  border-radius: 8rpx;
}

.photo-caption {
  margin-top: 11rpx;
  color: #050505;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.photo-meta {
  margin-top: 6rpx;
  color: #777777;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 26rpx;
}

.unlock-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 48rpx;
  padding: 0 26rpx;
  color: #050505;
  background: #ffffff;
  border: 1rpx solid #d0d0d0;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.unlock-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 22rpx;
  color: #ffffff;
  background: #050505;
  border-radius: 8rpx;
  font-size: 27rpx;
}

.unlock-message {
  margin-top: 20rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 34rpx;
}
