.top-scroll-mask {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  width: 100vw;
  height: 116rpx;
  background: #fbfbfb;
  pointer-events: none;
}

.hairline {
  width: 100%;
  height: 1rpx;
  background: #d8d8d8;
}

.hero-line {
  margin-top: 42rpx;
}

.couple-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 115rpx;
}

.days,
.names {
  display: flex;
  align-items: center;
  height: 38rpx;
}

.days {
  flex: 0 0 auto;
}

.names {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 286rpx;
  width: 286rpx;
}

.days__label {
  color: #111111;
  font-size: 25rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  line-height: 34rpx;
}

.days__value {
  margin: 0 18rpx;
  color: #050505;
  font-size: 35rpx;
  font-weight: 400;
  letter-spacing: 7rpx;
  line-height: 38rpx;
}

.name {
  width: 142rpx;
  color: #111111;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-align: center;
}

.name-divider {
  width: 1rpx;
  height: 30rpx;
  background: #d5d5d5;
}

.weather-section {
  display: flex;
  align-items: center;
  min-height: 126rpx;
}

.weather-copy {
  min-width: 0;
}

.weather-place {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-label {
  color: #8a8a8a;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  line-height: 22rpx;
}

.weather-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 58rpx;
}

.weather-icon {
  flex: 0 0 51rpx;
  width: 51rpx;
  height: 51rpx;
}

.temperature {
  flex: 0 0 118rpx;
  color: #050505;
  font-size: 43rpx;
  font-weight: 300;
  line-height: 1;
  text-align: center;
}

.weather-copy {
  flex: 1 1 auto;
  padding-top: 2rpx;
}

.weather-name {
  color: #111111;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.weather-place {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 21rpx;
  line-height: 1;
}

.location-action {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1;
}

.chevron {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

.quick-grid {
  display: flex;
  align-items: center;
  height: 140rpx;
}

.quick-item {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #111111;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
}

.quick-icon {
  flex: 0 0 auto;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 16rpx;
}

.quick-separator {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 54rpx;
  background: #d3d3d3;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 34rpx;
}

.section-title {
  margin-top: 15rpx;
  color: #050505;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.view-all {
  display: flex;
  align-items: center;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1;
}

.moment-list {
  margin-top: 24rpx;
}

.moment-empty {
  height: 114rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 114rpx;
}

.moment-row {
  display: flex;
  align-items: center;
  height: 114rpx;
}

.moment-row + .moment-row {
  border-top: 1rpx solid #eeeeee;
}

.moment-date {
  width: 80rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1;
}

.moment-main {
  flex: 1;
  min-width: 0;
  padding-left: 10rpx;
}

.moment-title {
  color: #050505;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
}

.moment-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #9a9a9a;
  font-size: 20rpx;
  line-height: 1;
}

.meta-pin {
  width: 21rpx;
  height: 21rpx;
  margin-right: 6rpx;
  opacity: 0.58;
}

.moment-thumb {
  width: 180rpx;
  height: 104rpx;
  margin-left: 22rpx;
  border-radius: 8rpx;
}

.section-line {
  margin-top: 11rpx;
}

.albums-head {
  margin-top: 34rpx;
}

.album-list {
  margin-top: 19rpx;
}

.album-empty {
  height: 109rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 109rpx;
}

.album-row {
  display: flex;
  align-items: center;
  height: 109rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.album-cover {
  width: 90rpx;
  height: 76rpx;
  border-radius: 7rpx;
}

.album-cover--lock {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
}

.lock-icon {
  width: 38rpx;
  height: 38rpx;
}

.album-main {
  flex: 1;
  min-width: 0;
  margin-left: 36rpx;
}

.album-title {
  color: #050505;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.album-count {
  margin-top: 13rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1;
}

.album-status {
  min-width: 82rpx;
  height: 38rpx;
  margin-right: 20rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d2d2d2;
  border-radius: 22rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.row-chevron {
  width: 32rpx;
  height: 32rpx;
}

.wishes {
  padding-top: 34rpx;
}

.wishes-label {
  margin-bottom: 24rpx;
}

.wish-empty {
  height: 58rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 58rpx;
}

.wish-row {
  display: flex;
  align-items: center;
  height: 58rpx;
}

.wish-icon {
  flex: 0 0 42rpx;
  width: 39rpx;
  height: 39rpx;
}

.wish-name {
  flex: 0 0 88rpx;
  margin-left: 24rpx;
  color: #050505;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.wish-progress {
  position: relative;
  flex: 1 1 auto;
  margin-left: 24rpx;
  height: 3rpx;
  background: #d9d9d9;
}

.wish-progress__bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 3rpx;
  background: #111111;
}

.wish-count {
  flex: 0 0 62rpx;
  margin-left: 24rpx;
  color: #8a8a8a;
  font-size: 24rpx;
  line-height: 1;
  text-align: right;
}

.wish-chevron {
  flex: 0 0 24rpx;
  margin-left: 24rpx;
  width: 26rpx;
  height: 26rpx;
}

.update-line {
  margin-top: 36rpx;
}

.update-section {
  position: relative;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.update-row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.update-main {
  flex: 1;
  min-width: 0;
}

.update-title {
  color: #050505;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.update-item {
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1;
}

.update-chevron {
  position: absolute;
  right: -3rpx;
  top: 82rpx;
  width: 30rpx;
  height: 30rpx;
}
