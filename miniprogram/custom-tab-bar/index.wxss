.snowlit-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  height: 112rpx;
  background: #ffffff;
  font-family: "Snowlit Sans", "Noto Sans SC", "Source Han Sans SC", "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.snowlit-tabbar__line {
  width: 100%;
  height: 1rpx;
  background: #d9d9d9;
}

.snowlit-tabbar__items {
  display: flex;
  height: 111rpx;
}

.snowlit-tabbar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  height: 111rpx;
  padding-top: 11rpx;
}

.snowlit-tabbar__icon {
  width: 40rpx;
  height: 40rpx;
}

.snowlit-tabbar__text {
  margin-top: 6rpx;
  min-width: 46rpx;
  color: #777777;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}

.snowlit-tabbar__text--active {
  color: #111111;
}

.snowlit-tabbar__indicator {
  width: 34rpx;
  height: 3rpx;
  margin-top: 12rpx;
  background: #111111;
}
